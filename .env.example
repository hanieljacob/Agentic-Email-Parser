# Copy to .env. Every value below is a default that already works for local
# development — the only one you must set is DATABASE_URL, and even that
# matches what `pnpm setup` creates.

# ── database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost/email_parser

# Used by the test suite only. It is dropped and recreated on every run, so
# point it somewhere disposable.
TEST_DATABASE_URL=postgresql://localhost/email_parser_test


# ── extraction ───────────────────────────────────────────────────────────────
# stub       deterministic canned responses from backend/fixtures. No network,
#            no key. This is the demo path.
# openrouter the real model.
# auto       openrouter when OPENROUTER_API_KEY is set, stub otherwise.
#
# Left as `stub` deliberately: `auto` would start making live calls the moment
# a key appears anywhere in the environment, which would make the demo depend
# on the machine it runs on.
LLM_PROVIDER=stub

# Only read when the provider resolves to openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-sonnet-4


# ── pipeline ─────────────────────────────────────────────────────────────────
# Changes scoring at or above this are written back without human review.
# The comparison is `>=`, so 0 does NOT disable auto-apply — it applies
# everything. To route every change to a human, set a value above 1.0.
AUTO_APPLY_THRESHOLD=0.95

# Where email attachments are written, named by content hash.
ATTACHMENTS_DIR=./attachments


# ── retry worker ─────────────────────────────────────────────────────────────
# Runs as a background task inside the API process, not as a separate service.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60
# How old an email must be before the worker will retry it, so it never races
# the request that just created it.
WORKER_GRACE_SECONDS=120
WORKER_MAX_RETRIES=3


# ── http ─────────────────────────────────────────────────────────────────────
API_PORT=8000
# JSON array — pydantic-settings parses complex types as JSON.
CORS_ORIGINS=["http://localhost:3000"]


# ── frontend ─────────────────────────────────────────────────────────────────
# Read by Vite at build time; must be reachable from the browser.
VITE_API_URL=http://localhost:8000
